{
  "name": "gemtopia",
  "version": "1.0.0",
  "private": true,
  "description": "Private crate-digging, shuffle player and playlist maker for your Discogs collection and wantlist.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "keygen": "node -e \"console.log('SESSION_SECRET=' + require('crypto').randomBytes(32).toString('base64url'))\"",
    "audit:ci": "npm audit --audit-level=high",
    "db:migrate": "node scripts/migrate.mjs",
    "verify:discogs": "node scripts/verify-discogs.mjs",
    "test": "npm run test:env && npm run test:tempo && npm run test:mixing && npm run test:api",
    "test:env": "node --experimental-strip-types scripts/test-env.mjs",
    "test:tempo": "node --experimental-strip-types scripts/test-tempo.mjs",
    "test:mixing": "node --experimental-strip-types scripts/test-mixing.mjs",
    "test:api": "node scripts/test-api.mjs"
  },
  "dependencies": {
    "next": "16.3.2",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/pg": "8.15.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  }
}
