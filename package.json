{
  "name": "gemtopia",
  "version": "1.0.0",
  "private": true,
  "description": "Private crate-digging, shuffle player and playlist maker for your Discogs collection and wantlist.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "keygen": "node -e \"console.log('SESSION_SECRET=' + require('crypto').randomBytes(32).toString('base64url'))\"",
    "audit:ci": "npm audit --audit-level=high",
    "db:migrate": "node scripts/migrate.mjs",
    "verify:discogs": "node scripts/verify-discogs.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "test": "npm run test:env && npm run test:headers && npm run test:playables && npm run test:sorting && npm run test:share && npm run test:scrub && npm run test:ownership && npm run test:recent && npm run test:adopt && npm run test:search && npm run test:writes && npm run test:playback && npm run test:tempo && npm run test:mixing && npm run test:api",
    "test:env": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-env.mjs",
    "test:headers": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-headers.mjs",
    "test:playables": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-playables.mjs",
    "test:sorting": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-sorting.mjs",
    "test:share": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-share.mjs",
    "test:scrub": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-scrub.mjs",
    "test:ownership": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-ownership.mjs",
    "test:recent": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-recent-playlists.mjs",
    "test:tempo": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-tempo.mjs",
    "test:mixing": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-mixing.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:adopt": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-adopt.mjs",
    "test:search": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-search-fields.mjs",
    "test:writes": "node scripts/test-write-surface.mjs",
    "test:playback": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/test-playback-errors.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "autoprefixer": "10.5.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "typescript": "5.8.3"
  }
}
