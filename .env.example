# ---------------------------------------------------------------------------
# Gemtopia configuration
#
# Copy to `.env.local` for local development. In production these are set as
# Vercel Environment Variables — never commit real values to git.
# ---------------------------------------------------------------------------

# --- Discogs (required) ----------------------------------------------------
# From https://www.discogs.com/settings/developers -> "Create an application".
# The callback URL you register there MUST be exactly:
#   <APP_ORIGIN>/api/auth/callback
DISCOGS_CONSUMER_KEY=
DISCOGS_CONSUMER_SECRET=

# Discogs requires a contact in the User-Agent. A URL or an email.
DISCOGS_CONTACT=+https://github.com/your-handle/gemtopia

# --- Session (required) ----------------------------------------------------
# 32 random bytes, base64url. Generate with:  npm run keygen
# Rotating this invalidates every signed-in session. That is the intended
# emergency "log everyone out" lever.
SESSION_SECRET=

# Canonical public origin, no trailing slash.
#   local:      http://localhost:3000
#   production: https://your-app.vercel.app
APP_ORIGIN=http://localhost:3000

# --- Database (required) ---------------------------------------------------
# Postgres. On Neon use the POOLED connection string — the host containing
# "-pooler" — because serverless functions open and drop connections
# constantly and would exhaust a direct endpoint.
#   Neon:  postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/gemtopia?sslmode=require
#   local: postgresql://postgres@127.0.0.1:5432/gemtopia
DATABASE_URL=

# --- AI ranking (optional) -------------------------------------------------
# Leave blank and the app still works: playlist analysis falls back to the
# deterministic Discogs-graph recommender and skips the written summary.
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model used for the ranking pass.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Per-user ceiling on LLM output tokens per rolling 24 hours. Stops one user
# — or one runaway loop — spending the whole deployment budget.
LLM_DAILY_OUTPUT_TOKEN_BUDGET=40000
